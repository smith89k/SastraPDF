{
  "name": "sastra-pdf",
  "productName": "Sastra PDF",
  "version": "1.1.2",
  "description": "Sastra PDF (សាស្ត្រា PDF) — combine, split, organize and export PDF pages",
  "main": "main.js",
  "author": "Sunnguon Taing",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/smith89k/SastraPDF.git"
  },
  "homepage": "https://github.com/smith89k/SastraPDF",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js && node scripts/copy-vendor.js && node scripts/check-credits.js",
    "start": "electron .",
    "build:menu": "node scripts/build-explorer-menu.js",
    "dist": "node scripts/check-notes.js && node scripts/build-explorer-menu.js && electron-builder --win nsis --publish never",
    "dist:portable": "node scripts/check-notes.js && node scripts/build-explorer-menu.js && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-khmer": "^5.3.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "build": {
    "appId": "kh.sastra.pdf",
    "productName": "Sastra PDF",
    "copyright": "© 2026 smith89k",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "explorer-menu.js",
      "updater.js",
      "update-config.json",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "explorer-menu/out",
        "to": "explorer-menu",
        "filter": [
          "SastraMenu.dll",
          "SastraPDF.ExplorerMenu.msix"
        ]
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://sastra-update.smith89k.com/"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Sastra-PDF-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sastra PDF",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Editor",
        "icon": "build/pdf-file.ico"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
